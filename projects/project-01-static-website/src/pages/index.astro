---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { category: "Cloud & DevOps", items: ["AWS", "Docker", "CI/CD", "Terraform"] },
  { category: "Backend", items: ["Node.js", "Python", "REST APIs", "PostgreSQL"] },
  { category: "Frontend", items: ["TypeScript", "React", "Astro", "CSS"] },
];

const projects = [
  {
    title: "Static Website on AWS",
    description:
      "This very portfolio — deployed to S3, served via CloudFront CDN, with a custom domain on Route 53.",
    tags: ["AWS S3", "CloudFront", "Route 53", "Astro"],
    link: "https://github.com/Guicbdiniz/aws-studies",
  },
  {
    title: "Serverless URL Shortener",
    description:
      "A fully serverless URL shortener built with Lambda, DynamoDB, and S3. Links expire automatically via DynamoDB TTL.",
    tags: ["AWS Lambda", "DynamoDB", "API Gateway"],
    link: "https://github.com/Guicbdiniz/aws-studies",
  },
  {
    title: "EC2 Web Server + VPC",
    description:
      "Custom VPC with public/private subnets, EC2 web server, CloudWatch monitoring, and automated alarms.",
    tags: ["EC2", "VPC", "CloudWatch", "IAM"],
    link: "https://github.com/Guicbdiniz/aws-studies",
  },
];
---

<BaseLayout title="Guilherme C. Bdiniz · Software Engineer">
  <!-- HERO -->
  <section id="about" class="hero">
    <div class="hero-content">
      <p class="hero-greeting">
        <span class="dot"></span> Available for opportunities
      </p>
      <h1>
        Hi, I'm <span class="highlight">Guilherme</span>.<br />
        I build things for the cloud.
      </h1>
      <p class="hero-sub">
        Software engineer focused on cloud-native architectures, serverless systems,
        and scalable backends. Currently deep-diving into AWS.
      </p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">See my work</a>
        <a
          href="https://github.com/Guicbdiniz"
          target="_blank"
          class="btn btn-ghost"
        >
          GitHub ↗
        </a>
      </div>
    </div>
    <div class="hero-code">
      <div class="code-card">
        <div class="code-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="filename">about.ts</span>
        </div>
        <pre><code><span class="kw">const</span> guilherme = &#123;
  <span class="prop">role</span>: <span class="str">"Software Engineer"</span>,
  <span class="prop">location</span>: <span class="str">"Brazil 🇧🇷"</span>,
  <span class="prop">focus</span>: <span class="str">"AWS & Cloud Native"</span>,
  <span class="prop">learning</span>: [
    <span class="str">"EC2"</span>, <span class="str">"Lambda"</span>,
    <span class="str">"ECS"</span>, <span class="str">"CDK"</span>
  ],
  <span class="prop">openTo</span>: <span class="kw">true</span>,
&#125;;</code></pre>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills">
    <p class="section-tag">// what I work with</p>
    <h2>Skills</h2>
    <div class="skills-grid">
      {
        skills.map((group) => (
          <div class="skill-card">
            <h3>{group.category}</h3>
            <ul>
              {group.items.map((item) => (
                <li>
                  <span class="check">▸</span> {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <p class="section-tag">// things I've built</p>
    <h2>Projects</h2>
    <p class="section-sub">
      Hands-on AWS projects built as part of my cloud learning roadmap.
    </p>
    <div class="projects-grid">
      {
        projects.map((project) => (
          <a href={project.link} target="_blank" class="project-card">
            <div class="project-top">
              <span class="folder-icon">📁</span>
              <span class="arrow">↗</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact">
    <p class="section-tag">// get in touch</p>
    <h2>Let's talk</h2>
    <p class="section-sub">
      I'm always open to discussing new projects, cloud architecture, or just
      geeking out about AWS.
    </p>
    <a href="mailto:guicbdinizp@gmail.com" class="btn btn-primary btn-lg">
      Say hello →
    </a>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 4rem 0;
  }

  .hero-greeting {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-green);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .hero-greeting .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-green);
    display: inline-block;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .highlight {
    color: var(--color-accent-light);
  }

  .hero-sub {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .btn-ghost {
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .btn-lg {
    padding: 1rem 2.5rem;
    font-size: 1rem;
  }

  /* CODE CARD */
  .hero-code {
    display: flex;
    justify-content: center;
  }

  .code-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }

  .code-header {
    background: var(--color-border);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .code-header .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .code-header .dot.red    { background: #ff5f57; }
  .code-header .dot.yellow { background: #febc2e; }
  .code-header .dot.green  { background: #28c840; }

  .filename {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  pre {
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.9;
    overflow-x: auto;
  }

  .kw   { color: #bd93f9; }
  .prop { color: #8be9fd; }
  .str  { color: #f1fa8c; }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .skill-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.2s;
  }

  .skill-card:hover {
    border-color: var(--color-accent);
  }

  .skill-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent-light);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skill-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skill-card li {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .check {
    color: var(--color-accent);
    margin-right: 0.4rem;
  }

  /* PROJECTS */
  .section-sub {
    color: var(--color-muted);
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .folder-icon { font-size: 1.75rem; }

  .arrow {
    color: var(--color-muted);
    font-size: 1.1rem;
    transition: color 0.2s;
  }

  .project-card:hover .arrow {
    color: var(--color-accent);
  }

  .project-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card p {
    font-size: 0.9rem;
    color: var(--color-muted);
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(124, 106, 247, 0.12);
    color: var(--color-accent-light);
    border: 1px solid rgba(124, 106, 247, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* CONTACT */
  .contact {
    text-align: center;
    padding: 8rem 0;
  }

  .contact h2 { font-size: 2.5rem; }
  .contact .section-sub { margin: 1rem auto 2.5rem; }
  .contact .btn { margin: 0 auto; }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 3rem 0;
      gap: 2.5rem;
    }

    .hero-code {
      order: -1;
    }
  }
</style>
